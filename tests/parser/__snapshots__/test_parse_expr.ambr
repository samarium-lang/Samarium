# serializer version: 1
# name: test_parse_chained_logical[&&]
  list([
    ExprStmt(
      expr=LogicalOp(
        op=<LogOp.AND: 2>,
        values=list([
          Identifier(name='a', inst=False, private=False),
          Identifier(name='b', inst=False, private=False),
          Identifier(name='c', inst=False, private=False),
          Identifier(name='d', inst=False, private=False),
          Identifier(name='e', inst=False, private=False),
        ]),
      ),
    ),
  ])
