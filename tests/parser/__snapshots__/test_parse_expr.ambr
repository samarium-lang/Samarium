    ExprStmt(
      expr=BinaryOp(
        lhs=UnaryOp(
          expr=Int(
            value=1,
          ),
          ops=list([
            <UnOp.SUB: 2>,
          ]),
        ),
        op=<BinOp.POW: 5>,
        rhs=Int(
          value=1,
        ),
      ),
    ),
  ])
